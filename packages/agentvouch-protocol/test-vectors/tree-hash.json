        {
          "path": "scripts/run.sh",
          "content_utf8": "#!/bin/sh\necho hello\n"
        },
        {
          "path": "references/api.md",
          "content_utf8": "# API\n\nGET /hello\n"
        },
        {
          "path": "Zebra.md",
          "content_utf8": "Zebra notes.\n"
        },
        {
          "path": "SKILL.md",
          "content_utf8": "---\nname: hello-world\ndescription: Say hello. Use when the user asks for a greeting.\n---\n\n# Hello World\n\nReply with one short greeting.\n"
        }
