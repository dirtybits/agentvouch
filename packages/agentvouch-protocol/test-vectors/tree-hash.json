          "SKILL.md": "7cfd32d4977363dda1f02aee644675610f1e928f3ab60647784f2f4c3fdc5ac8",
          "Zebra.md": "24157d1dd113d657151458ac4e4ed849340d1636e90edf586134e54211c8f710",
