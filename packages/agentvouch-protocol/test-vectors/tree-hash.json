    {
      "id": "astral-vs-bmp-order",
      "description": "U+1F600 (code units D83D DE00) sorts before U+FF5E in UTF-16 code unit order, but after it in code point or UTF-8 byte order. Use code unit order.",
      "files": [
        {
          "path": "SKILL.md",
          "content_utf8": "---\nname: hello-world\ndescription: Say hello. Use when the user asks for a greeting.\n---\n\n# Hello World\n\nReply with one short greeting.\n"
        },
        {
          "path": "notes/\uff5e.md",
          "content_utf8": "Fullwidth tilde.\n"
        },
        {
          "path": "notes/\ud83d\ude00.md",
          "content_utf8": "Smile.\n"
        }
      ],
      "expected": {
        "sorted_paths": [
          "SKILL.md",
          "notes/\ud83d\ude00.md",
          "notes/\uff5e.md"
        ],
        "file_sha256": {
          "SKILL.md": "7cfd32d4977363dda1f02aee644675610f1e928f3ab60647784f2f4c3fdc5ac8",
          "notes/\ud83d\ude00.md": "80b766b7ddc31cbe62fbd7b38d4cde0b0dd5d9f9cfee610249aa2088bf401c88",
          "notes/\uff5e.md": "bdbd7ad0693edfd96ba2202d25d05ba56aaa5b6ff30c0ab079be01ecc0b54025"
        },
        "tree_hash": "6072afea213178dc29888c4274499d06c9ca95673258f343f79928a52d946c5d"
      }
    },
